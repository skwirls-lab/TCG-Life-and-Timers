{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -- --port 3190 --host 127.0.0.1",
      "startServerReadyPattern": "All emulators ready",
      "url": [
        "http://127.0.0.1:3190/",
        "http://127.0.0.1:3190/setup",
        "http://127.0.0.1:3190/settings"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox",
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "artifacts/lhci"
    }
  }
}
