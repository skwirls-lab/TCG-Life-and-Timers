{
  "name": "tcg-life-and-timers",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings=0 . && tsx scripts/check-i18n.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,storage,auth --project demo-tcg-life \"vitest run -c vitest.rules.config.ts\"",
    "test:functions": "firebase emulators:exec --only firestore,storage,auth --project demo-tcg-life \"vitest run -c vitest.functions.config.ts\"",
    "test:sync": "firebase emulators:exec --only firestore,auth,storage --project demo-tcg-life \"vitest run -c vitest.sync.config.ts\"",
    "test:e2e": "npm run build:test && playwright test --grep-invert @emu",
    "test:e2e:emu": "npm run build:emu && E2E_SERVER=emu firebase emulators:exec --only firestore,storage,auth --project demo-tcg-life \"playwright test --grep @emu\"",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "check:presets": "tsx scripts/check-presets.ts",
    "check:trace": "tsx scripts/trace.ts",
    "screens": "playwright test -c playwright.screens.config.ts",
    "lhci": "npm run build && bash scripts/lhci.sh",
    "emulators": "firebase emulators:start --project demo-tcg-life",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "build:test": "NEXT_DIST_DIR=.next-test NEXT_PUBLIC_TEST_HOOKS=1 next build",
    "start:test": "NEXT_DIST_DIR=.next-test next start",
    "build:emu": "NEXT_DIST_DIR=.next-emu NEXT_PUBLIC_TEST_HOOKS=1 NEXT_PUBLIC_USE_EMULATORS=1 next build",
    "start:emu": "NEXT_DIST_DIR=.next-emu next start",
    "test:e2e:only": "playwright test --grep-invert @emu",
    "test:acceptance": "bash scripts/acceptance.sh"
  },
  "dependencies": {
    "@sentry/browser": "^11.10.0",
    "dexie": "^4.4.7",
    "firebase": "^13.1.0",
    "lucide-react": "^1.66.0",
    "nanoid": "^6.0.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "serwist": "^9.5.13",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@serwist/turbopack": "^9.5.13",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "fake-indexeddb": "^6.2.7",
    "fast-check": "^4.10.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.2",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
