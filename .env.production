# Public build config for the production static export (`npm run build`, DEPLOY.md Part 3).
# Firebase web config values are public client keys, not secrets: they ship in every page.
# The e2e builds (`build:test`, `build:emu`) blank every key in this file (scripts/build.ts).

# Firebase web config for project "tcgtempo".
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC-Zr9pG7KrioS8dgylefMmBnmSDNu3VcY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tcgtempo.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tcgtempo
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tcgtempo.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=726097197982
NEXT_PUBLIC_FIREBASE_APP_ID=1:726097197982:web:23278537501a963abaf48f
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-W9VJDCXYV2
NEXT_PUBLIC_PAYWALL_ENABLED=0

# Stripe prices for "TCGTempo Pro" (public ids; DEPLOY.md Part 7). No lifetime price is sold, so
# the purchase panel shows only Monthly and Yearly.
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=price_1UdwGcArytmUxb6t7Ik7ScRb
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=price_1UdwGcArytmUxb6tJrrS0mpq
NEXT_PUBLIC_PRICE_DISPLAY_MONTHLY=$1.99
NEXT_PUBLIC_PRICE_DISPLAY_YEARLY=$19.99

# Same-origin sign-in handler on a custom domain (DEPLOY.md Part 9). `*.web.app` and
# `*.firebaseapp.com` hosts are same-origin automatically. List a custom domain only after
# adding https://<domain>/__/auth/handler to the OAuth client's redirect URIs.
NEXT_PUBLIC_AUTH_SAME_ORIGIN_HOSTS=

# Optional (DEPLOY.md Parts 2, 7 and 8):
# NEXT_PUBLIC_APPCHECK_SITE_KEY=your-recaptcha-enterprise-site-key
# NEXT_PUBLIC_SENTRY_DSN=https://...@....ingest.sentry.io/...
