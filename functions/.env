# Non-secret Cloud Functions params (firebase-functions/params, DEPLOY.md Part 7). Loaded by every
# deploy and by the emulators; `.env.<project-id>` overrides it per project. Secrets
# (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) never go here: they live in Secret Manager.

# Server allowlist of purchasable recurring prices (comma-separated): monthly $1.99, yearly $19.99.
# Going live: replace with the LIVE-mode price ids (and update .env.production to match).
STRIPE_PRICE_IDS=price_1UdwGcArytmUxb6t7Ik7ScRb,price_1UdwGcArytmUxb6tJrrS0mpq
# One-time prices that grant lifetime Pro. None is sold today.
LIFETIME_PRICE_IDS=
# Default origin of the Checkout success / cancel and portal return URLs.
APP_BASE_URL=https://tcgtempo.skwirls.com
# Origins the app may ask to return to (others fall back to APP_BASE_URL).
APP_RETURN_ORIGINS=https://tcgtempo.skwirls.com,https://tcgtempo.web.app
# Stripe Tax on Checkout (set up Stripe Tax in the dashboard first).
STRIPE_AUTOMATIC_TAX=false
